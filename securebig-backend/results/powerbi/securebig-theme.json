{
  "name": "SecureBig SOC Dark",
  "dataColors": [
    "#00F0FF", "#A855F7", "#FF3B5C", "#00FF9D",
    "#FFB020", "#4C6EF5", "#F06595", "#38BDF8"
  ],
  "good": "#00FF9D",
  "neutral": "#FFB020",
  "bad": "#FF3B5C",
  "background": "#0D1426",
  "foreground": "#E6F1FF",
  "tableAccent": "#00F0FF",
  "visualStyles": {
    "*": {
      "*": {
        "*": [
          {
            "background": { "color": { "solid": { "color": "#0D1426" } }, "transparency": 0 },
            "border": { "show": true, "color": { "solid": { "color": "#1E2A44" } }, "radius": 8 }
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          { "color": { "solid": { "color": "#070B16" } }, "transparency": 0 }
        ],
        "outspace": [
          { "color": { "solid": { "color": "#04060D" } }, "transparency": 0 }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          { "color": { "solid": { "color": "#00F0FF" } }, "fontSize": 22, "fontFamily": "Segoe UI Semibold" }
        ],
        "categoryLabels": [
          { "color": { "solid": { "color": "#8B9BB4" } }, "fontSize": 10 }
        ]
      }
    }
  },
  "textClasses": {
    "title": { "fontFace": "Segoe UI Semibold", "fontColor": "#E6F1FF", "fontSize": 14 },
    "label": { "fontFace": "Segoe UI", "fontColor": "#8B9BB4", "fontSize": 10 },
    "callout": { "fontFace": "Segoe UI Semibold", "fontColor": "#00F0FF", "fontSize": 24 }
  }
}
