table FACT_USER_WEEK_FEATURES
	lineageTag: 184a30b4-52c8-41e6-967a-97bf1b5513e8

	measure 'Suspicious User-Weeks' = CALCULATE ( COUNTROWS ( FACT_USER_WEEK_FEATURES ), FACT_USER_WEEK_FEATURES[prediction] = 1 )
		formatString: #,0
		lineageTag: 9d5a06b6-b922-46d7-a528-1db1ca5187e1

	measure 'Avg Suspicion Score' = AVERAGE ( FACT_USER_WEEK_FEATURES[suspicion_prob] )
		formatString: 0.0000
		lineageTag: 208cc030-cc50-4f8d-a439-b7c490ea6cd2

	measure 'High-Risk Users' = COUNTROWS ( FILTER ( VALUES ( FACT_USER_WEEK_FEATURES[user] ), CALCULATE ( MAX ( FACT_USER_WEEK_FEATURES[suspicion_prob] ) ) > 0.5 ) )
		formatString: #,0
		lineageTag: 83b7f3da-c45b-4978-9040-ad080a72f263

	measure 'User-Week Count' = COUNTROWS ( FACT_USER_WEEK_FEATURES )
		formatString: #,0
		lineageTag: fdd851d6-ba57-45db-95c6-7218996ca1c0

	measure 'Event Count' = SUM ( FACT_USER_WEEK_FEATURES[total_events] )
		formatString: #,0
		lineageTag: 8413e49b-b7d1-4a2a-bbd9-7cc588c1a6b9

