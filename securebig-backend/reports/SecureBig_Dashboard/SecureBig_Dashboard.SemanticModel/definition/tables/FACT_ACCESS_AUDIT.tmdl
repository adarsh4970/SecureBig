table FACT_ACCESS_AUDIT
	lineageTag: 28bf779b-5af0-4491-9193-481d3d00a0dc

	measure 'Audit Decision Count' = COUNTROWS ( FACT_ACCESS_AUDIT )
		formatString: #,0
		lineageTag: a7ff4e12-a87c-4551-9b37-d3754b50c217

	measure 'GRANT Count' = CALCULATE ( COUNTROWS ( FACT_ACCESS_AUDIT ), FACT_ACCESS_AUDIT[decision] = "GRANT" )
		formatString: #,0
		lineageTag: 4991176e-0aa3-4fe8-af8b-d69af0c355bc

	measure 'DENY Count' = CALCULATE ( COUNTROWS ( FACT_ACCESS_AUDIT ), FACT_ACCESS_AUDIT[decision] = "DENY" )
		formatString: #,0
		lineageTag: d68d92ef-7e72-4787-9627-53e3778fe74a

	column role
		dataType: string
		lineageTag: 2021a718-d3b6-46aa-9f6b-7cca38e03633
