	column note
		dataType: string
		lineageTag: 74672ade-eb5e-4f58-b948-84a02e2f6564
		sourceColumn: note

	partition FACT_ACCESS_AUDIT = m
		mode: import
		source =
				let
					Source = Excel.Workbook(File.Contents("C:\\Users\\Adarsh singh\\.zcode\\workspace\\default\\securebig-backend\\results\\powerbi\\SecureBig_Tables.xlsx"), null, false),
					Sheet = Source{[Item="FACT_ACCESS_AUDIT",Kind="Sheet"]}[Data],
